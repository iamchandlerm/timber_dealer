<style>
    #shopify-section-{{ section.id }} {
        width: 100%;
  }
  .db-cover-banner{
    width: 100%;
    height: 500px;
    display:grid;
    grid-template-columns: 4fr 6fr;
    grid-template-areas: "main inquire";
  }
    .db-cover-banner__content{
            width: 100%;
            height: 100%;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
    }

    .db-cover-banner__content--main{
            grid-area: main;
    }

    .db-cover-banner__content--inquire{
            grid-area: inquire;
    }

    .db-cover-banner__image, .placeholder-image{
            width: 100%;
            height: 100%;
            object-fit: cover;
            position:absolute;
    }

    .db-cover-banner__logo{
        z-index: 1;
        width: 340px;
        height: 300px;
    }
    .db-cover-banner__inquire-content{
        z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 358px;
    gap: 11px;
    }


    .db-cover-banner__inquire-content .db-cover-banner__inquire-heading{
        font-family: "Roboto slab", serif;
        font-size: 36px;
        line-height: 1.11;
        color: #F1F3F4;
        text-align: center;
    }
    .db-cover-banner__inquire-content .db-cover-banner__inquire-button{
        width: 191px;
        height: 64px;
        background-color: #C20502;
        color: #F1F3F4;
        text-align: center;
        font-size: 16px;
        font-family: 'Poppins', sans-serif;
        border: none;

    }
</style>

<div
  id="shopify-section-{{section.id}}"
  class="
    db-cover-banner
    section section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    gap-style
  "
>
  <div class="db-cover-banner__content db-cover-banner__content--main">
    <!-- Content for the cover banner goes here -->
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: loading: 'lazy', class: 'db-cover-banner__image'
      }}
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'placeholder-image' }}
    {% endif %}
    <div class="db-cover-banner__logo">
      <!-- Logo content goes here -->
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: loading: 'lazy', class: 'db-cover-banner__logo-image'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-image' }}
      {% endif %}
    </div>
  </div>

  <div class="db-cover-banner__content db-cover-banner__content--inquire">
    <!-- Content for the cover banner goes here -->
    {% if section.settings.inquire_background_image != blank %}
      {{
        section.settings.inquire_background_image
        | image_url: width: 900
        | image_tag: loading: 'lazy', class: 'db-cover-banner__image'
      }}
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'placeholder-image' }}
    {% endif %}

    <div class="db-cover-banner__inquire-content">
      <h2 class="db-cover-banner__inquire-heading">{{ section.settings.inquire_heading }}</h2>
      <button class="db-cover-banner__inquire-button">{{ section.settings.inquire_button_text }}</button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "db-cover-banner",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "image_picker",
      "id": "inquire_background_image",
      "label": "'Inquire' Section Background Image"
    },
    {
      "type": "text",
      "id": "inquire_heading",
      "label": "'Inquire' Section Heading",
      "default": "Decking Timberin Aukland"
    },
    {
      "type": "text",
      "id": "inquire_button_text",
      "label": "'Inquire' Section Button Text",
      "default": "ENQUIRE NOW"
    }
  ],
  "presets": [
    {
      "name": "db cover banner"
    }
  ]
}
{% endschema %}

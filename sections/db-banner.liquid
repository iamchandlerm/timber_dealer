<style>
    #shopify-section-{{ section.id }} {
        position: relative;
        width: 100%;
        margin: auto;
        height: {{ section.settings.section_height }}px;
    }

    #shopify-section-{{ section.id }} .db-banner, 
    #shopify-section-{{ section.id }} .db-banner__swiper {
        height: 100%;
    }

    #shopify-section-{{ section.id }} .db-banner__slide-content {
        position: relative;
        max-width: 717px;
    }
    
    #shopify-section-{{ section.id }} .swiper-slide {
        width: 100%;
        padding-left: 128px;
        padding-right: 128px;
        display: flex !important;
    }

    #shopify-section-{{ section.id }} .db-banner__inner {
        flex: 1; 
        width: 100%;    
    }

    #shopify-section-{{ section.id }} .db-banner__swiper img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;  
    }

    #shopify-section-{{ section.id }} .db-heading {
        margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .swiper-scrollbar {
        width: 158px !important;
        position: absolute;
        left: initial;
        right: 128px;
        bottom: 90px;
        background: rgb(194, 5, 2, .5);
    }

    #shopify-section-{{ section.id }} .swiper-scrollbar-drag {
        background-color: #C20502 !important;
    }
</style>

<div id="{{ section.settings.custom_id }}" class="db-banner section section--{{ section.settings.section_width }} spacing-style gap-style">
    <div class="db-overlay {{ section.settings.overlay_opacity }}"></div>
    <div class="db-banner__inner">
        <div class="swiper db-banner__swiper">
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    {%- case block.type -%}
                        {%- when 'banner_slide' -%}
                            <div class="swiper-slide db-flex {{ block.settings.content_position }}" {{ block.shopify_attributes }}>
                                <img src="{{ block.settings.slide_image | img_url: 'master' }}" alt="" {{ block.shopify_attributes }}>
                                <div class="db-banner__slide-content"> 
                                    <div class="db-overlay {{ block.settings.overlay_opacity }}"></div>
                                    <h2 class="db-heading" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}">{{ block.settings.heading }}</h2>
                                    <p class="db-body" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
                                </div>
                            </div>
                    {%- endcase -%}
                {% endfor %}
            </div>
            <div class="swiper-scrollbar"></div>
        </div>
    </div>
</div>

<script>
    let swiper = new Swiper(".db-banner__swiper", {
      scrollbar: {
        el: ".swiper-scrollbar",
        hide: false,
      },
    });
</script>

{% schema %}
    {
        "name": "DB Banner",
        "settings": [
            {
                "type": "text",
                "id": "custom_id",
                "label": "Custom ID"
            },
            {
                "type": "range",
                "id": "section_height",
                "label": "Section height (px)",
                "min": 400,
                "max": 800,
                "step": 20,
                "default": 740
            },
            {
                "type": "select",
                "id": "section_width",
                "label": "Width",
                "options": [
                    {
                        "value": "full-width",
                        "label": "Full width"
                    },
                    {
                        "value": "page-width",
                        "label": "Page width"
                    }
                ],
                "default": "full-width"
            },
            {
                "type": "select",
                "id": "overlay_opacity",
                "label": "Overlay opacity",
                "options": [
                    {
                        "value": "db-overlay-0",
                        "label": "0%"
                    },
                    {
                        "value": "db-overlay-10",
                        "label": "10%"
                    },
                    {
                        "value": "db-overlay-20",
                        "label": "20%"
                    },
                    {
                        "value": "db-overlay-30",
                        "label": "30%"
                    },
                    {
                        "value": "db-overlay-40",
                        "label": "40%"
                    },
                    {
                        "value": "db-overlay-50",
                        "label": "50%"
                    },
                    {
                        "value": "db-overlay-60",
                        "label": "60%"
                    }
                ],
                "default": "db-overlay-40"
            }
        ],
        "blocks": [
            {
                "type": "banner_slide",
                "name": "Banner slide",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "slide_image",
                        "label": "Slide image"
                    },
                    {
                        "type": "richtext",
                        "id": "heading",    
                        "label": "Heading"
                    },
                    {
                        "type": "text",
                        "id": "description",
                        "label": "Description"
                    },
                    {
                        "type": "color",
                        "id": "heading_color",
                        "label": "Heading color"
                    },
                    {
                        "type": "color",
                        "id": "description_color",
                        "label": "Description color"
                    },
                    {
                        "type": "select",
                        "id": "overlay_opacity",
                        "label": "Overlay opacity",
                        "options": [
                            {
                                "value": "db-overlay-0",
                                "label": "0%"
                            },
                            {
                                "value": "db-overlay-10",
                                "label": "10%"
                            },
                            {
                                "value": "db-overlay-20",
                                "label": "20%"
                            },
                            {
                                "value": "db-overlay-30",
                                "label": "30%"
                            },
                            {
                                "value": "db-overlay-40",
                                "label": "40%"
                            },
                            {
                                "value": "db-overlay-50",
                                "label": "50%"
                            },
                            {
                                "value": "db-overlay-60",
                                "label": "60%"
                            }
                        ],
                        "default": "db-overlay-40"
                    },
                    {
                        "type": "select",
                        "id": "content_position",
                        "label": "Content position",
                        "options": [
                            {
                                "value": "db-flex-start",
                                "label": "Left"
                            },
                            {
                                "value": "db-flex-center",
                                "label": "Center"
                            },
                            {
                                "value": "db-flex-end",
                                "label": "Right"
                            }
                        ],
                        "default": "db-flex-center"
                    }
                ]
            }
        ],
        "presets": [
            {
            "name": "DB Banner"
            }
        ]
    }
{% endschema %}

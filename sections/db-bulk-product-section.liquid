<style>
  #{{section.id}}
{
  margin-top: 100px;
}
img.db-bulk-products__product-image {
  width: 282px;
  height: 285px;
  position: relative;
  background-color: #F5F5F5;
}

.db-bulk-products__content {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 41px;
  column-gap: 17px;
  justify-content: center;
  padding: 0 128px;
}

.db-bulk-products__product {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 270px;

  .db-bulk-products__product-address {
    font-size: 16px;
    font-family: 'Roboto Slab';
    color: #888888;
  }

  .db-bluk-products__product-name {
    font-size: 20px;
    font-family: 'Roboto Slab';
    font-weight: bold;
  }
  .db-bulk-products__product-price {
    font-size: 20px;
    font-family: 'Poppins';
    font-weight: bold;
    color: #C20502;
  }
}

.db-bulk-products__heading {
  width: 377px;
  color: #000;
  font-size: 64px;
  font-family: "Roboto Slab";
  font-weight: bold;
  line-height: 1.055;
  text-align: center;
  margin: 41px auto;

}

.db-bulk-products__container {
  width: 100%;
}

.swiper-wrapper .swiper-slide {
  background-color: #fff;
}

.swiper-pagination {
  display: flex;
  align-items: center;
}

.swiper-pagination-bullet:not(:last-child)::after {
  content: "|";
  margin: 0 8px;
}

.swiper-pagination-bullet {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #000;
  opacity: 0.2;
}
.swiper-pagination.swiper-pagination-clickable.swiper-pagination-bullets.swiper-pagination-horizontal {
  position: relative;
  height: 100px;
  font-size: 20px;
  font-family: 'Poppins';
  font-weight: bold;
  justify-content: center;
}

</style>

<div
  id="{{section.id}}"
  class="
    db-bulk-product
    section section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    gap-style
    swiper mySwiper
  "
  data-pagination-type="{{section.settings.pagination}}">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide">
        {% assign selected_product = block.settings.selected_product %}
        <div class="db-bulk-products__container" {{ block.shopify_attributes }}>
          <div class="db-bulk-products__heading">{{ block.settings.heading }}</div>
          <div class="db-bulk-products__content">

            {% for variant in selected_product.variants limit: block.settings.max_products %}

              <div class="db-bulk-products__product">
                {{ variant.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'db-bulk-products__product-image' }}
                <p class="db-bulk-products__product-address">
                  {{ variant.metafields.custom.location }}</p>
                <h2 class="db-bluk-products__product-name">{{ variant.title }}</h2>
                <p class="db-bulk-products__product-price">{{ variant.price | money }}</p>
              </div>

            {% endfor %}
          </div>

        </div>


      </div>
    {% endfor %}

  </div>
  <div class="swiper-pagination"></div>
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
</div>

{% schema %}
  {
    "name": "bulk product section",
    "settings": [
      {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          }, {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      }, {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:settings.color_scheme",
        "default": "scheme-1"
      }, {
        "type": "select",
        "id": "pagination",
        "label": "Pagination",
        "default": "progressbar",
        "options": [
          {
            "value": "progressbar",
            "label": "progres bar"
          }, {
            "value": "bullets",
            "label": "bullets"
          }
        ]
      }
    ],

    "blocks": [
      {
        "type": "product_items",
        "name": "product items",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "slide title"
          }, {
            "type": "product",
            "id": "selected_product",
            "label": "product to feature"
          }, {
            "type": "number",
            "id": "max_products",
            "label": "max products to show"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "huge product page",
        "blocks": [
          {
            "type": "product_items",
            "settings": {
              "heading": "Bulk Products",
              "selected_product": "product-1",
              "max_products": 8
            }
          }
        ]

      }
    ]
  }
{% endschema %}
<style>
  .db-banner {
    width: 100%;
    height: 837px;
  }


  .db-banner__image--item {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .db-banner__content {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    padding: 0 128px;
    align-items: center;
  }

  .db-banner__content-items {
    max-width: 516px;
  }

  .db-banner__paragraph {
    margin-top: 17px;
    font-family: 'Poppins'
    , sans-serif;
    font-size: 16px;
    width: 100%;
  }

  .db-banner__content h1 p {
    font-size: 49px;
    font-family: "Roboto slab"
    , serif;
    line-height: 1.05;
  }

  .swiper-slide--left {
    justify-content: start;
    .db-banner__content-items {
      text-align: left;
    }
  }

  .swiper-slide--center {
    justify-content: center;
    .db-banner__content-items {
      text-align: center;
    }
  }

  .swiper-slide--right {
    justify-content: end;
    .db-banner__content-items {
      text-align: right;
    }
  }

  .swiper-pagination.swiper-pagination-progressbar.swiper-pagination-horizontal {
    top: 90%;
    left: 85%;
    width: 100px;
  }
  .swiper-pagination-progressbar {
    background-color: rgb(194, 5, 2, 0.5);
    .swiper-pagination-progressbar-fill {
      background-color: #C20502;
    }
  }


</style>

<div
  id="{{section.id}}"
  class="
    db-banner
    section section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    gap-style
    swiper mySwiper
  "
  data-pagination:="{{section.settings.pagination}}">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {% if block.type == 'image_slider' %}
        <div class="swiper-slide">
          {% if block.settings.slide_image != blank %}
            {{
              block.settings.slide_image | image_url: width: 1441 | image_tag: class: 'db-banner__image--item', loading: 'lazy'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-image' }}
          {% endif %}
          <div class="db-banner__content swiper-slide--{{ block.settings.text_alignment }}">
            <div class="db-banner__content-items">
              <h1>{{ block.settings.slide_text }}</h1>
              <p class="db-banner__paragraph">{{ block.settings.paragraph }}</p>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-pagination"></div>
</div>


{% schema %}
  {
    "name": "Hero banner",
    "settings": [
      {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          }, {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      }, {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:settings.color_scheme",
        "default": "scheme-1"
      }, {
        "type": "select",
        "id": "pagination",
        "label": "Pagination",
        "options": [
          {
            "value": "true",
            "label": "progres bar"
          }, {
            "value": "false",
            "label": "bullets"
          }
        ],
        "default": "true"
      }
    ],
    "blocks": [
      {
        "type": "image_slider",
        "name": "image Slider",
        "settings": [
          {
            "type": "image_picker",
            "id": "slide_image",
            "label": "Image Slider:"
          }, {
            "type": "richtext",
            "id": "slide_text",
            "label": "Heading Text",
            "default": "<h1>Heading Text</h1>"
          }, {
            "type": "text",
            "id": "paragraph",
            "label": "paragraph"
          }, {
            "type": "select",
            "id": "text_alignment",
            "label": "Text Alignment",
            "options": [
              {
                "value": "left",
                "label": "Left"
              }, {
                "value": "center",
                "label": "Center"
              }, {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "right"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "hero banner: copy"
      }
    ]
  }
{% endschema %}
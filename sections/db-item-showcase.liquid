<style>
    #shopify-section-{{section.id}}{
      width: 100%;
    }
    .db-item-showcase{
        width: 100%;
        height: 650px;
        display: grid;
        grid-template-columns: 6fr minmax(0, 4fr);
        grid-template-areas: "first second";
    }
    .db-item-showcase__content{
      width: 100%;
      height: 100%;
      position: relative;
    }
    .db-item-showcase__background{
      width: 100%;
      height: 100%;
    }
    .db-item-showcase--first_item{
      grid-area: first;
      .db-item-showcase__background--color{
          background-color: {{section.settings.first_color}};
          position: absolute;
      }
    }
    .db-item-showcase__background--color{
      width: 100%;
      height: 90%;
    }
    .db-item-showcase__background_image{
      position: absolute;
      width: 100%;
      height: 100%;
      display: flex;
      /* change image position */
      justify-content: start;
      align-items: start;
    }

    .bd-item-showcase__bg-image{
      width: 624px;
      height: 557px;
      position: absolute;
      bottom: 0;
    }

    .db-item-showcase__items {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0 5%;

    display: flex;
    align-items: center;
  }

  .db-item-showcase__items-contents{
    width: 300px;
    display: flex;
    gap: 24px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .db-item-showcase__heading{
    color: #fff;
    font-size: 36px;
    font-family: "Roboto Slab";
    font-weight: bold;
    line-height: 1.11;
  }
  .db-item-showcase__image-container{
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .db-item-showcase__first-image--modifier{
    width: var(--first_image_size);
    height: auto;
  }
  .db-item-showcase__second-image--modifier{
    width: var(--second_image_size);
    height: auto;
  }


  .db-item-showcase__button{
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    button{
      color: #C20502;
    }
  }

  .db-item-showcase__heading--left{
    text-align: start;
  }
  .db-item-showcase__heading--center{
    text-align: center;
  }
  .db-item-showcase__heading--right{
    text-align: right;
  }



  .db-item-showcase__items--left, .db-item-showcase__button--left, .db-item-showcase__image--left{
    justify-content: start;
  }
  .db-item-showcase__items--center, .db-item-showcase__button--center, .db-item-showcase__image--center{
    justify-content: center;
  }
  .db-item-showcase__items--right, .db-item-showcase__button--right, .db-item-showcase__image--right{
    justify-content: end;
  }


    .db-item-showcase--second_item{
      grid-area: second;
      .db-item-showcase__background--color{
          background-color: {{section.settings.second_color}};
          position: absolute;
      }
    }
</style>

<div
  id="shopify-section-{{section.id}}"
  class="
    db-item-showcase
    section section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    gap-style
  "
>
  <div class="db-item-showcase__content db-item-showcase--first_item">
    <div class="db-item-showcase__background">
      <div class="db-item-showcase__background--color"></div>
      {% if section.settings.first_section_image != blank %}
        <div class="db-item-showcase__background_image">
          {{
            section.settings.first_section_image
            | image_url: width: 800
            | image_tag: loading: 'lazy', class: 'bd-item-showcase__bg-image'
          }}
        </div>
      {% endif %}

      <div class="db-item-showcase__items db-item-showcase__items--{{section.settings.first_content_position}}">
        <div class="db-item-showcase__items-contents">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'first_heading' %}
                  <h2
                    class="db-item-showcase__heading db-item-showcase__heading--{{block.settings.first_heading_position}}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.first_heading }}
                  </h2>
                {% when 'first_image' %}
                  <div
                    class="db-item-showcase__image-container db-item-showcase__image--{{block.settings.first_image_position}}"
                    {{ block.shopify_attributes }}
                    style="--first_image_size: {{block.settings.first_image_size}}px"
                  >
                    {{
                      block.settings.first_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        class: 'db-item-showcase__image db-item-showcase__first-image--modifier'
                    }}
                  </div>
                {% when 'first_button' %}
                  <div
                    class="db-item-showcase__button db-item-showcase__button--{{block.settings.first_button_position}}"
                    {{ block.shopify_attributes }}
                  >
                    <button>
                      {{ block.settings.first_button }}
                    </button>
                  </div>
              {% endcase %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="db-item-showcase__content db-item-showcase--second_item">
    <div class="db-item-showcase__background">
      <div class="db-item-showcase__background--color"></div>
      {% if section.settings.second_section_image != blank %}
        <div class="db-item-showcase__background_image">
          {{
            section.settings.second_section_image
            | image_url: width: 800
            | image_tag: loading: 'lazy', class: 'bd-item-showcase__bg-image'
          }}
        </div>
      {% endif %}

      <div class="db-item-showcase__items db-item-showcase__items--{{section.settings.second_content_position}}">
        <div class="db-item-showcase__items-contents">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'second_heading' %}
                  <h2
                    class="db-item-showcase__heading db-item-showcase__heading--{{block.settings.second_heading_position}}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.second_heading }}
                  </h2>
                {% when 'second_image' %}
                  <div
                    class="db-item-showcase__image-container db-item-showcase__image--{{block.settings.second_image_position}}"
                    {{ block.shopify_attributes }}
                    style="--second_image_size: {{block.settings.second_image_size}}px"
                  >
                    {{
                      block.settings.second_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        class: 'db-item-showcase__image db-item-showcase__second-image--modifier'
                    }}
                  </div>
                {% when 'second_button' %}
                  <div
                    class="db-item-showcase__button db-item-showcase__button--{{block.settings.second_button_position}}"
                    {{ block.shopify_attributes }}
                  >
                    <button>
                      {{ block.settings.second_button }}
                    </button>
                  </div>
              {% endcase %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "db item showcase",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "first Section content"
    },
    {
      "type": "color",
      "id": "first_color",
      "label": "first section background color:"
    },
    {
      "type": "image_picker",
      "id": "first_section_image",
      "label": "first section image:"
    },
    {
      "type": "select",
      "id": "first_section_image_position",
      "label": "image position",
      "options": [
        {
          "value": "left",
          "label": "left"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "right",
          "label": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "first_content_position",
      "label": "content position",
      "options": [
        {
          "value": "left",
          "label": "left"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "right",
          "label": "right"
        }
      ]
    },
    {
      "type": "header",
      "content": "second Section content"
    },
    {
      "type": "color",
      "id": "second_color",
      "label": "second section background color:"
    },
    {
      "type": "image_picker",
      "id": "second_section_image",
      "label": "second section image:"
    },
    {
      "type": "select",
      "id": "second_section_image_position",
      "label": "image position",
      "options": [
        {
          "value": "left",
          "label": "left"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "right",
          "label": "right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "first_heading",
      "name": "first heading",
      "settings": [
        {
          "type": "text",
          "id": "first_heading",
          "label": "first section heading",
          "default": "heading"
        },
        {
          "type": "select",
          "id": "first_heading_position",
          "label": "heading position",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
        }
      ]
    },
    {
      "type": "first_image",
      "name": "first image",
      "settings": [
        {
          "type": "image_picker",
          "id": "first_image",
          "label": "first section image"
        },
        {
          "type": "select",
          "id": "first_image_position",
          "label": "image position",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
        },
        {
          "type": "range",
          "id": "first_image_size",
          "min": 250,
          "max": 450,
          "step": 2,
          "label": "size (px)",
          "unit": "px",
          "default": 350
        }
      ]
    },
    {
      "type": "first_button",
      "name": "first button",
      "settings": [
        {
          "type": "text",
          "id": "first_button",
          "label": "first section button"
        },
        {
          "type": "select",
          "id": "first_button_position",
          "label": "button position",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
        }
      ]
    },
    {
      "type": "second_heading",
      "name": "second heading",
      "settings": [
        {
          "type": "text",
          "id": "second_heading",
          "label": "second section heading",
          "default": "heading"
        },
        {
          "type": "select",
          "id": "second_heading_position",
          "label": "heading position",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
        }
      ]
    },
    {
      "type": "second_image",
      "name": "second image",
      "settings": [
        {
          "type": "image_picker",
          "id": "second_image",
          "label": "second section image"
        },
        {
          "type": "select",
          "id": "second_image_position",
          "label": "image position",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
        },
        {
          "type": "range",
          "id": "second_image_size",
          "min": 250,
          "max": 450,
          "step": 2,
          "label": "size (px)",
          "unit": "px",
          "default": 350
        }
      ]
    },
    {
      "type": "second_button",
      "name": "second button",
      "settings": [
        {
          "type": "text",
          "id": "second_button",
          "label": "second section button"
        },
        {
          "type": "select",
          "id": "second_button_position",
          "label": "button position",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "db item showcase"
    }
  ]
}
{% endschema %}

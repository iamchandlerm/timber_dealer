<style>
    #shopify-section-{{section.id}} {
      position: relative;
      height: 100vh;
      width: 100%;
    }

  .swiper {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    text-align: center;
    font-size: 18px;
    background: #444;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .db-banner__content {
    z-index: 2;
    color: #000000;
    width: 717px;
    text-align: right;
  }
  .db-banner__content h1 {
    font-size: 49px;
    font-family: "Roboto slab", serif;
    line-height: 1.05;
  }

  .swiper-slide--left{
    justify-content: flex-start;
    text-align: left;
    .db-banner__content {
      text-align: left;
    }
  }

  .swiper-slide--center{
    justify-content: center;
    text-align: center;
    .db-banner__content {
      text-align: center;
    }
  }

  .swiper-slide--right{
    justify-content: flex-end;
    text-align: right;
  }
</style>

<div
  id="{{section.id}}"
  class="
    db-banner
    section section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    gap-style
    swiper mySwiper
  "
>
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {% if block.type == 'image_slider' %}
        <div class="swiper-slide swiper-slide--{{ block.settings.text_alignment }}">
          {% if block.settings.slide_image != blank %}
            {{
              block.settings.slide_image
              | image_url: width: 1400
              | image_tag: class: 'db-banner__image--item', loading: 'lazy'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-image' }}
          {% endif %}
          <div class="db-banner__content">
            <h1>{{ block.settings.slide_text | escape }}</h1>
            <p>{{ block.settings.paragraph }}</p>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-pagination"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var swiper = new Swiper('.mySwiper', {
      pagination: {
        el: '.swiper-pagination',
        type: 'progressbar',
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image_slider",
      "name": "image Slider",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Image Slider:"
        },
        {
          "type": "text",
          "id": "slide_text",
          "label": "Heading Text",
          "default": "Heading Text"
        },
        {
          "type": "richtext",
          "id": "paragraph",
          "label": "paragraph"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "hero banner:"
    }
  ]
}
{% endschema %}
